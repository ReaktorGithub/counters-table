{
  "useTabs": false,
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "printWidth": 80,

  "quoteProps": "as-needed",

  "bracketSpacing": true,
  "bracketSameLine": false,

  "arrowParens": "always",
  "endOfLine": "lf",

  "jsxSingleQuote": false,
  "jsxBracketSameLine": false,

  "embeddedLanguageFormatting": "auto"
}
